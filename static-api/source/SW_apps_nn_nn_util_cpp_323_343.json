[{"file":"SW/apps/nn/nn_util.cpp","start":319,"highlight":[323,343],"lines":["","// Some supporting functions to intepret inference results...","","// Load label file ","ZtaStatus NeuralNet::LabelLoad(const char *fname) {","   FILE *fp;","   char str[200];","   fp=fopen(fname,\"r\");","   if(!fp) {","      return ZtaStatusFail;","   }","   m_labels.clear();","   while(fgets(str,sizeof(str)-1,fp)) {","      strtok(str,\"\\r\\n\");","      m_labels.push_back(str);","   }","   fclose(fp);","   return ZtaStatusOk;","}","","// Get string associated with a label ID","","const char *NeuralNet::LabelGet(int _idx) {","   return (_idx < (int)m_labels.size())?m_labels[_idx].c_str():0;","}","","// Find the top5 result from the list","","ZtaStatus NeuralNet::GetTop5(uint8_t *prediction,int predictionSize,int *top5)"]}]